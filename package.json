{
  "name": "wbook",
  "version": "0.1.1",
  "private": true,
  "license": "LGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "bindings:generate": "cargo run --manifest-path backend/Cargo.toml -p wbook --example export_bindings",
    "bindings:check": "cargo run --manifest-path backend/Cargo.toml -p wbook --example export_bindings -- --check",
    "bindings:typecheck": "tsc --project tsconfig.bindings.json",
    "build": "vite build",
    "dev": "vite",
    "postinstall": "husky install",
    "lint": "nr lint:eslint && nr lint:ts && nr lint:styles && nr lint:backend",
    "lint:backend": "cargo clippy --manifest-path=./backend/Cargo.toml --all-targets --all-features",
    "lint:eslint": "eslint --cache .",
    "lint:styles": "stylelint --allow-empty-input \"**/*.{css,scss}\"",
    "lint:ts": "tsc --noEmit",
    "pkg:fmt": "prettier --write package.json",
    "pkg:sort": "nlx sort-package-json",
    "pkg:up": "nlx npm-check-updates -i",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "nr test:unit && nr test:backend && nr test:e2e",
    "test:unit": "vitest",
    "test:e2e": "wdio run ./wdio.conf.ts",
    "test:backend": "cargo test --manifest-path=./backend/Cargo.toml --all-features"
  },
  "dependencies": {
    "@lit/react": "1.0.8",
    "@m3e/react": "2.10.2",
    "@m3e/web": "2.10.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "class-variance-authority": "0.7.1",
    "lit": "3.3.3",
    "motion": "14.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swr": "2.5.1",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@antfu/ni": "30.6.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@eslint/compat": "2.1.1",
    "@iconify/json": "2.2.544",
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-helmet": "6.1.11",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "@wdio/cli": "10.1.0",
    "@wdio/globals": "10.1.0",
    "@wdio/local-runner": "10.1.0",
    "@wdio/mocha-framework": "10.1.0",
    "@wdio/spec-reporter": "10.1.0",
    "@wdio/types": "10.1.0",
    "autoprefixer": "10.6.1",
    "clsx": "2.1.1",
    "colord": "2.10.0",
    "cross-env": "10.1.0",
    "dayjs": "1.11.23",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-standard": "17.1.0",
    "eslint-import-resolver-alias": "1.1.2",
    "eslint-plugin-html": "8.2.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "husky": "9.1.7",
    "i18next": "26.5.8",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "ofetch": "1.5.1",
    "postcss": "8.5.30",
    "postcss-html": "2.0.0",
    "postcss-import": "17.0.1",
    "postcss-scss": "4.0.9",
    "prettier": "3.9.10",
    "qs": "6.16.1",
    "react-helmet": "6.1.0",
    "react-i18next": "17.1.6",
    "sass": "1.105.2",
    "shikiji": "0.10.2",
    "stylelint": "17.16.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-recess-order": "7.8.2",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-block-no-ignored-properties": "3.0.0",
    "stylelint-order": "8.1.2",
    "stylelint-scss": "7.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "ts-node": "10.9.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "unplugin-icons": "24.0.0",
    "vite": "8.3.5",
    "vite-plugin-i18next-loader": "4.1.0",
    "vite-plugin-markdown": "2.2.0",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "5.0.5",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "packageManager": "pnpm@12.14.0"
}
