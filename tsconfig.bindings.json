{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/bindings.ts",
    "src/transport.ts",
    "src/types/vite-env.d.ts",
    "tests/utils/transport.test.ts"
  ]
}
